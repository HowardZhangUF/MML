  "metric_definitions": {
    "process_noise": "std (m) of isotropic Gaussian position jitter added once per predict step; Q = q^2 I",
    "exit top-1 (success)": "label with the largest weighted particle mass, EXIT_HORIZON steps after the target re-appears, predicted without measurements from the last occluded step, equals the side the target exits; labels N/E/S/W/in, 'in' never counts as an exit; ties -> first label in N,E,S,W,in order (np.argmax)",
    "exit >50% (majority)": "more than half the weighted mass lies beyond the actual exit side",
    "P(correct)": "weighted mass beyond the actual exit side (timed-region probability, not a route choice)",
    "RMSE": "per-episode RMSE of the weighted particle mean after the step (post-resampling), averaged over episodes; +- in the old table = population std across episodes",
    "scoring time": "fork at exit_step-1 (last occluded step), 1+EXIT_HORIZON predict-only steps; the returning measurement is never used",
    "lane-cue reference": "events whose exit matches the approach lane (north lane -> N, south lane -> S)"
  },
